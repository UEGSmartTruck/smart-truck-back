<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  SmartTruck Backend - Checkstyle Configuration

  Enforces:
  - Object Calisthenics subset (indentation, method length, parameters)
  - Clean Architecture (forbidden imports in domain layer)
  - Code style (Google Java Style Guide)
  - Javadoc requirements

  Usage:
    mvn checkstyle:check

  To suppress specific violations:
    @SuppressWarnings("checkstyle:RuleName")
-->

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Suppress warnings for generated code -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"
                  default="checkstyle-suppressions.xml"/>
    </module>

    <!-- TreeWalker checks -->
    <module name="TreeWalker">

        <!-- ===== OBJECT CALISTHENICS RULES ===== -->

        <!-- Rule: Max 2 levels of indentation per method -->
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
            <message key="nested.if.depth"
                     value="Indentation too deep (max 2 levels). Consider extracting to a method."/>
        </module>

        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>

        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>

        <!-- Rule: Small methods (max 20 lines) -->
        <module name="MethodLength">
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
            <property name="tokens" value="METHOD_DEF"/>
            <message key="maxLen.method"
                     value="Method too long ({0,number,integer} lines). Max is {1,number,integer}. Break into smaller methods."/>
        </module>

        <!-- Rule: Max 3 parameters per method -->
        <module name="ParameterNumber">
            <property name="max" value="3"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <message key="maxParam"
                     value="Too many parameters ({0,number,integer}). Max is {1,number,integer}. Consider a parameter object."/>
        </module>

        <!-- Rule: Low cyclomatic complexity -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
            <message key="cyclomaticComplexity"
                     value="Cyclomatic complexity is {0,number,integer} (max is {1,number,integer}). Simplify the logic."/>
        </module>

        <!-- Rule: Small classes (max 200 lines) -->
        <module name="FileLength">
            <property name="max" value="200"/>
            <property name="fileExtensions" value="java"/>
        </module>

        <!-- ===== CLEAN ARCHITECTURE RULES ===== -->

        <!-- Forbid Spring/JPA imports in domain layer -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="org.springframework, jakarta.persistence, javax.persistence"/>
            <property name="illegalClasses" value=""/>
            <message key="import.illegal"
                     value="Domain layer must not depend on framework packages (Spring, JPA). Keep domain pure."/>
        </module>

        <!-- ===== JAVADOC REQUIREMENTS ===== -->

        <!-- Require Javadoc on public classes -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="excludeScope" value=""/>
            <property name="skipAnnotations" value="Test, ParameterizedTest, RepeatedTest"/>
            <message key="javadoc.missing"
                     value="Public class/interface missing Javadoc. Document what it does and why."/>
        </module>

        <!-- Require Javadoc on public methods -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="minLineCount" value="2"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
            <property name="ignoreMethodNamesRegex" value="^(get|set|is)[A-Z].*"/>
            <property name="allowedAnnotations" value="Override, Test, Before, After, BeforeEach, AfterEach"/>
            <message key="javadoc.missing"
                     value="Public method missing Javadoc. Document @param, @return, @throws."/>
        </module>

        <!-- Validate Javadoc structure -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected"/>
            <property name="validateThrows" value="true"/>
            <message key="javadoc.return.expected"
                     value="Javadoc missing @return tag."/>
            <message key="javadoc.expectedTag"
                     value="Javadoc missing @param or @throws tag."/>
        </module>

        <!-- ===== CODE STYLE (Google Java Style Guide subset) ===== -->

        <!-- Indentation: 4 spaces -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="8"/>
        </module>

        <!-- No wildcard imports -->
        <module name="AvoidStarImport">
            <message key="import.avoidStar"
                     value="Avoid wildcard imports. Import specific classes."/>
        </module>

        <!-- Unused imports -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- Import order -->
        <module name="ImportOrder">
            <property name="groups" value="/^java\./,javax,org,com"/>
            <property name="separated" value="true"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <!-- Naming conventions -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Type name ''{0}'' must start with uppercase letter and use PascalCase."/>
        </module>

        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Method name ''{0}'' must start with lowercase letter and use camelCase."/>
        </module>

        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
            <message key="name.invalidPattern"
                     value="Constant name ''{0}'' must be UPPER_CASE."/>
        </module>

        <!-- Braces required -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="false"/>
            <message key="needBraces"
                     value="Always use braces, even for single-line if/for/while."/>
        </module>

        <!-- Avoid empty blocks -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Final parameters (encourages immutability) -->
        <module name="FinalParameters">
            <property name="ignorePrimitiveTypes" value="false"/>
            <message key="final.parameter"
                     value="Parameter should be final to prevent reassignment."/>
        </module>

        <!-- ===== BEST PRACTICES ===== -->

        <!-- Avoid magic numbers -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <message key="magic.number"
                     value="Magic number {0}. Extract to a named constant."/>
        </module>

        <!-- Equals and hashCode consistency -->
        <module name="EqualsHashCode">
            <message key="equals.noHashCode"
                     value="Override hashCode() when overriding equals()."/>
        </module>

        <!-- Simplify boolean expressions -->
        <module name="SimplifyBooleanExpression">
            <message key="simplify.expression"
                     value="Simplify boolean expression (e.g., if (b == true) → if (b))."/>
        </module>

        <!-- Simplify boolean returns -->
        <module name="SimplifyBooleanReturn">
            <message key="simplify.boolreturn"
                     value="Simplify boolean return (e.g., return b == true; → return b;)."/>
        </module>

        <!-- No empty statements -->
        <module name="EmptyStatement">
            <message key="empty.statement"
                     value="Empty statement (standalone semicolon). Remove it."/>
        </module>

        <!-- Avoid nested assignments -->
        <module name="InnerAssignment">
            <message key="assignment.inner.avoid"
                     value="Avoid assignment inside expression. Extract to separate line."/>
        </module>

    </module>

    <!-- ===== FILE-LEVEL CHECKS ===== -->

    <!-- Max line length: 100 characters -->
    <module name="LineLength">
        <property name="max" value="100"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
        <message key="maxLineLen"
                 value="Line is longer than {0,number,integer} characters (found {1,number,integer}). Break into multiple lines."/>
    </module>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

</module>
