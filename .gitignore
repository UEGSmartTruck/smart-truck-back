# ==========================
# 🌱 Projeto Java (Maven)
# ==========================

# Compilação e artefatos
target/
out/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Logs e relatórios
*.log
hs_err_pid*
replay_pid*

# Arquivos temporários e backups do Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Maven Wrapper (binário)
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ==========================
# 💡 IntelliJ IDEA
# ==========================

# Ignorar tudo da pasta .idea
.idea/

# Exceto formatação e inspeção compartilhadas (opcional)
!.idea/codeStyles/
!.idea/inspectionProfiles/

# Arquivos de módulo
*.iml

# ==========================
# 💻 Visual Studio Code
# ==========================

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Histórico local e extensões
.history/
*.vsix

# ==========================
# ⚙️ Ambiente e ferramentas
# ==========================

# Variáveis de ambiente e configs locais
.env
.env.local
.env.*.local
application-dev.yml
application-prod.yml

# Arquivos temporários de sistema
.DS_Store
Thumbs.db

